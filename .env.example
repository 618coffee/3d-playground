# Local-only agent API settings. Do not commit real provider secrets.
AGENT_API_PORT=8787
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Configure an OpenAI-compatible chat completions endpoint for the local agent API.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_ACCESS_TOKEN=
LLM_API_VERSION=2024-12-01-preview
LLM_AUTH_HEADER=
LLM_TIMEOUT_MS=30000

# Optional frontend override. By default Vite proxies /api to http://127.0.0.1:8787.
# VITE_AGENT_API_URL=http://127.0.0.1:8787/api/agent/respond

# Azure AI Foundry / AI Services example:
# Use the AI Services or Cognitive Services model endpoint, not the Foundry project endpoint.
# LLM_PROVIDER=azure-ai-inference
# LLM_BASE_URL=https://<resource-name>.cognitiveservices.azure.com
# LLM_MODEL=<deployment-name>
# LLM_API_KEY=<resource-key>
